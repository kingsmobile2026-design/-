local function getCompatibleChars(char)
    local map = {
        ["픠"] = {"픠", "피"}, ["피"] = {"픠", "피"},
        ["듸"] = {"듸", "디"}, ["디"] = {"듸", "디"},
        ["븨"] = {"븨", "비"}, ["비"] = {"븨", "비"},
        ["긔"] = {"긔", "기"}, ["기"] = {"긔", "기"},
        ["믜"] = {"믜", "미"}, ["미"] = {"믜", "미"},
        ["늬"] = {"늬", "니"}, ["니"] = {"늬", "니"},
        ["씌"] = {"씌", "씨"}, ["씨"] = {"씌", "씨"},
        ["틔"] = {"틔", "티"}, ["티"] = {"틔", "티"},
        ["롸"] = {"롸", "라"}, ["라"] = {"롸", "라"}
    }
    return map[char] or {char}
end

